{
  "name": "framework",
  "private": true,
  "version": "0.1.3",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:e2e": "tsc && vite build --mode e2e",
    "lint": "eslint src e2e",
    "lint:rust": "cargo clippy --workspace --all-targets",
    "test": "vitest run",
    "sign:e2e": "codesign --force --deep --sign - target/debug/bundle/macos/FrameWork.app",
    "prepare:e2e:samples": "cargo run -p framework-core --example generate_sample_documents",
    "test:e2e": "npm run prepare:e2e:samples && tauri build --debug --bundles app --features e2e --config e2e/tauri.e2e.conf.json && npm run sign:e2e && npm run test:e2e:only",
    "test:e2e:only": "for f in e2e/specs/*.e2e.ts; do wdio run e2e/wdio.conf.ts --spec \"$f\" || exit 1; done",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
