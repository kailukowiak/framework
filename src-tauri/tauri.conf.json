{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameWork",
  "version": "0.1.2",
  "identifier": "com.framework.canvas",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FrameWork",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026 Kai Lukowiak",
    "shortDescription": "A free-form canvas for structured data",
    "longDescription": "FrameWork is a desktop canvas for people who reach for a spreadsheet because they want to see and touch their data directly, but who think in dataframes rather than in cell addresses. Tables and calculation blocks sit on a movable canvas, cells are identified by table, row, and column rather than by grid position, and calculated columns hold parsed expressions that survive a rename.",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["fw"],
        "name": "FrameWork.Document",
        "description": "FrameWork structured-data canvas",
        "mimeType": "application/x-framework-document",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.framework.canvas.document",
          "conformsTo": ["public.json", "public.content"]
        }
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/com.framework.canvas.desktop": "packaging/linux/com.framework.canvas.desktop",
          "/usr/share/applications/FrameWork.desktop": "packaging/linux/FrameWork.desktop",
          "/usr/share/mime/packages/com.framework.canvas.xml": "packaging/linux/com.framework.canvas.xml",
          "/usr/share/metainfo/com.framework.canvas.metainfo.xml": "packaging/linux/com.framework.canvas.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/framework-desktop.svg": "packaging/linux/framework-desktop.svg"
        },
        "desktopTemplate": "packaging/linux/main.desktop",
        "postInstallScript": "packaging/linux/postinst",
        "postRemoveScript": "packaging/linux/postrm"
      },
      "rpm": {
        "files": {
          "/usr/share/applications/com.framework.canvas.desktop": "packaging/linux/com.framework.canvas.desktop",
          "/usr/share/mime/packages/com.framework.canvas.xml": "packaging/linux/com.framework.canvas.xml",
          "/usr/share/metainfo/com.framework.canvas.metainfo.xml": "packaging/linux/com.framework.canvas.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/framework-desktop.svg": "packaging/linux/framework-desktop.svg"
        },
        "desktopTemplate": "packaging/linux/FrameWork.desktop",
        "postInstallScript": "packaging/linux/postinst",
        "postRemoveScript": "packaging/linux/postrm"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3N0I0NTdFMUQ2NEVCMjgKUldRbzYyUWRma1Y3dDJ0VWZ2U3kxU0hJN2NUandZRVhITThZNzU2Rm1GaWI0MDBjSjNFWXRyNHoK",
      "endpoints": [
        "https://github.com/kailukowiak/framework/releases/latest/download/latest.json"
      ]
    }
  }
}
